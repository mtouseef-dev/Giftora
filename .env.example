# Database Connections
# MongoDB Atlas Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.giftora.mongodb.net/giftora_db?retryWrites=true&w=majority"

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/giftora_db?schema=public"

# Authentication Secrets
JWT_SECRET="giftora_super_secure_jwt_secret_key_2026"
NEXTAUTH_SECRET="giftora_nextauth_secret_key_2026"

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_giftora_live_key"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# Cloudinary Storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="giftora-media"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Frontend / API URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
